# ── Local development ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env
# Production values are set in Render's Environment Variables dashboard,
# NOT in this file. Never commit a .env with real secrets.

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEV: leave everything below commented — SQLite is used automatically.
# RENDER PRODUCTION: Render injects DATABASE_URL automatically when you attach
# a PostgreSQL database. No need to set DB_ENGINE or any DB_* vars on Render.
# SELF-HOSTED POSTGRES: uncomment DB_ENGINE + DB_* vars below.

# DB_ENGINE=postgresql
# DB_NAME=bitchat
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Permanent file storage for images and profile pictures.
# Sign up free at https://cloudinary.com (no credit card needed).
# Set these three in Render Environment Variables for production.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Leave blank locally. Set in Render Environment Variables for production.
# Get your DSN free at https://sentry.io — create a Django project.
SENTRY_DSN=
