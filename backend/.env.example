# Copy this file to .env and fill in your values
# cp .env.example .env

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE=sqlite   ← default, no setup needed (development)
# DB_ENGINE=postgresql  ← set this for production, then fill in below
DB_ENGINE=sqlite
# DB_NAME=bitchat
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Media files — local dev only (Render filesystem is ephemeral, use Cloudinary in prod)
MEDIA_ROOT=
MEDIA_URL=/media/

# Cloudinary — permanent file storage for images, audio, profile pictures
# Sign up free at https://cloudinary.com — no credit card needed
# Set these in Render environment variables for production
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
