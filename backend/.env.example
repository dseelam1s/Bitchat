# Copy this file to .env and fill in your values
# cp .env.example .env

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE=sqlite   ← default, no setup needed (development)
# DB_ENGINE=postgresql  ← set this for production, then fill in below
DB_ENGINE=sqlite
# DB_NAME=bitchat
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Media files (profile pictures)
# Leave empty to use local filesystem (development)
# Set to an S3/GCS bucket URL in production
MEDIA_ROOT=
MEDIA_URL=/media/
